{
  "manifest_version": 3,
  "name": "CCF Lens",
  "version": "1.0.1",
  "description": "在 Google Scholar、ACM Digital Library、IEEE Xplore 和 DBLP 页面显示 CCF 2026 推荐等级。",
  "homepage_url": "https://github.com/qirunzeng/CCF-Lens-Safari",
  "action": {
    "default_title": "CCF Lens",
    "default_popup": "WebExtension/popup.html"
  },
  "icons": {
    "16": "WebExtension/icons/icon-16.png",
    "32": "WebExtension/icons/icon-32.png",
    "48": "WebExtension/icons/icon-48.png",
    "128": "WebExtension/icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://scholar.google.com/*",
        "https://dl.acm.org/*",
        "https://ieeexplore.ieee.org/*",
        "https://dblp.org/*",
        "https://dblp.uni-trier.de/*"
      ],
      "js": [
        "WebExtension/catalog.js",
        "WebExtension/content.js"
      ],
      "css": [
        "WebExtension/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
